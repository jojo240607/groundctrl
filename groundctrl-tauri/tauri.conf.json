{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GroundControl",
  "version": "0.1.0",
  "identifier": "com.groundctrl.station",
  "build": {
    "frontendDist": "../ui-web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui-web run dev",
    "beforeBuildCommand": "npm --prefix ../ui-web run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "地面站 GroundControl",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "飞控地面站 GroundControl",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
